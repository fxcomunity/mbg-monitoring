# ============================================================
#  MBG-MONITORING — Environment Variables TEMPLATE
#  Salin file ini menjadi .env lalu isi nilainya.
#  File ini AMAN untuk di-commit ke Git.
# ============================================================

# ── App ─────────────────────────────────────────────────────
APP_NAME="Radar MBG Nasional"
APP_ENV=production
APP_URL=https://your-domain.com

# ── Database Online ─────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=your-db-host.provider.com
DB_PORT=3306
DB_NAME=radar_mbg
DB_USER=your_db_username
DB_PASS=your_db_password
DB_SSL=true
DB_SSL_CA=

# ── Upload ──────────────────────────────────────────────────
UPLOAD_MAX_MB=10

# ── CORS ────────────────────────────────────────────────────
ALLOWED_ORIGIN=https://your-domain.com
