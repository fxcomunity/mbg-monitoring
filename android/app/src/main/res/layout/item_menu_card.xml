<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/bgn_border_subtle"
    app:cardBackgroundColor="@color/bgn_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Status & Portion Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvSchoolName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SDN 01 Senayan Jakarta"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/bgn_primary" />

            <TextView
                android:id="@+id/tvCaloriesBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_gradient_primary"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="620 kkal"
                android:textColor="@color/bgn_tertiary_fixed"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Menu Title -->
        <TextView
            android:id="@+id/tvMenuTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Paket Ayam Panggang Madu &amp; Tempe Bacem"
            android:textSize="14sp"
            android:textColor="@color/bgn_secondary"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- Description -->
        <TextView
            android:id="@+id/tvMenuDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rendah natrium, menggunakan bahan pangan lokal segar binaan koperasi tani."
            android:textSize="12sp"
            android:textColor="@color/bgn_on_surface_variant"
            android:layout_marginBottom="12dp" />

        <!-- Nutrition & Temperature Indicators -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tvTempStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Suhu: 68.4°C (Hangat)"
                android:textSize="11sp"
                android:textColor="@color/bgn_status_success"
                android:textStyle="bold"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/tvDietitianName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dietisien: Terverifikasi"
                android:textSize="11sp"
                android:textColor="@color/bgn_on_surface_variant" />
        </LinearLayout>

        <!-- Action Button: Open Google Maps for this School/SPPG -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenMaps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/action_open_maps"
            app:icon="@drawable/ic_location"
            app:iconGravity="textStart"
            app:iconTint="@color/bgn_primary"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:textColor="@color/bgn_primary"
            app:strokeColor="@color/bgn_border_focus"
            app:cornerRadius="12dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
