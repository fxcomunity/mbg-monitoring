<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Material3 Theme -->
    <style name="Theme.RadarMBG" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary Brand Colors -->
        <item name="colorPrimary">@color/bgn_primary</item>
        <item name="colorOnPrimary">@color/bgn_on_primary</item>
        <item name="colorPrimaryContainer">@color/bgn_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/bgn_on_primary_container</item>

        <!-- Secondary Colors -->
        <item name="colorSecondary">@color/bgn_secondary</item>
        <item name="colorOnSecondary">@color/bgn_on_secondary</item>
        <item name="colorSecondaryContainer">@color/bgn_secondary_fixed</item>

        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/bgn_background</item>
        <item name="colorSurface">@color/bgn_surface</item>
        <item name="colorOnSurface">@color/bgn_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/bgn_on_surface_variant</item>

        <!-- System Bars -->
        <item name="android:statusBarColor">@color/bgn_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/bgn_surface</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="Theme.RadarMBG.Splash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bgn_primary</item>
        <item name="android:statusBarColor">@color/bgn_primary</item>
        <item name="android:navigationBarColor">@color/bgn_primary</item>
    </style>
</resources>
