<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinatorLayout"
    android:layoutWidth="match_parent"
    android:layoutHeight="match_parent"
    android:background="@color/bgn_background">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layoutWidth="match_parent"
        android:layoutHeight="wrap_content"
        android:background="@color/bgn_primary"
        app:elevation="4dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topToolbar"
            android:layoutWidth="match_parent"
            android:layoutHeight="@dimen/toolbar_height"
            android:background="@color/bgn_primary"
            app:title="@string/app_name"
            app:titleTextColor="@color/bgn_on_primary"
            app:subtitle="@string/bgn_institution_name"
            app:subtitleTextColor="@color/bgn_on_primary_container">

            <LinearLayout
                android:layoutWidth="wrap_content"
                android:layoutHeight="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/ivStatusDot"
                    android:layoutWidth="8dp"
                    android:layoutHeight="8dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_location"
                    app:tint="@color/bgn_status_success"
                    android:contentDescription="Live Status" />

                <TextView
                    android:layoutWidth="wrap_content"
                    android:layoutHeight="wrap_content"
                    android:text="Online"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/bgn_tertiary_fixed" />
            </LinearLayout>

        </com.google.android.material.appbar.MaterialToolbar>

        <!-- Loading Progress Bar -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/pageProgressBar"
            android:layoutWidth="match_parent"
            android:layoutHeight="3dp"
            android:indeterminate="false"
            android:visibility="gone"
            app:indicatorColor="@color/bgn_tertiary_fixed"
            app:trackColor="@color/bgn_primary_container" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content: SwipeRefreshLayout + WebView -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layoutWidth="match_parent"
        android:layoutHeight="match_parent"
        android:layout_marginBottom="@dimen/bottom_nav_height"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <FrameLayout
            android:layoutWidth="match_parent"
            android:layoutHeight="match_parent">

            <!-- Primary Web View -->
            <WebView
                android:id="@+id/mainWebView"
                android:layoutWidth="match_parent"
                android:layoutHeight="match_parent"
                android:overScrollMode="never" />

            <!-- Offline Error State Container -->
            <LinearLayout
                android:id="@+id/errorContainer"
                android:layoutWidth="match_parent"
                android:layoutHeight="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone"
                android:background="@color/bgn_background">

                <ImageView
                    android:layoutWidth="72dp"
                    android:layoutHeight="72dp"
                    android:src="@drawable/ic_laporan"
                    app:tint="@color/bgn_status_warning"
                    android:contentDescription="Error Icon" />

                <TextView
                    android:layoutWidth="wrap_content"
                    android:layoutHeight="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/network_error_title"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/bgn_on_surface"
                    android:textAlignment="center" />

                <TextView
                    android:layoutWidth="wrap_content"
                    android:layoutHeight="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/network_error_message"
                    android:textSize="14sp"
                    android:textColor="@color/bgn_on_surface_variant"
                    android:textAlignment="center" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetryConnection"
                    android:layoutWidth="wrap_content"
                    android:layoutHeight="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/action_retry"
                    android:backgroundTint="@color/bgn_primary"
                    android:textColor="@color/bgn_on_primary"
                    app:cornerRadius="12dp" />
            </LinearLayout>

        </FrameLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layoutWidth="match_parent"
        android:layoutHeight="@dimen/bottom_nav_height"
        android:layout_gravity="bottom"
        android:background="@color/bgn_surface"
        app:elevation="8dp"
        app:itemIconTint="@color/bgn_primary"
        app:itemTextColor="@color/bgn_primary"
        app:menu="@menu/bottom_nav_menu" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
